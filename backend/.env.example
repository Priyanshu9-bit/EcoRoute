# EcoRoute Backend Environment Variables Template

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecoroute?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=Ashish@7008

# Security & JWT Configuration
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated origins allowed to make requests)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://*.vercel.app

# External API Keys (Optional - Open-Meteo & OSRM work automatically without keys)
OPENROUTE_API_KEY=your_openrouteservice_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here
